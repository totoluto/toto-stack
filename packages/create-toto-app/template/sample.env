# Environment for local development and for docker compose. Copy to .env
# (create-toto-app already generated one with random secrets) and never commit it.

# ---------------------------------------------------------------- runtime ---
# "development" or "test" enable dev mode (plain-http cookies, localhost
# origins); anything else, or unset, is production mode. `npm run dev`
# defaults to development, `npm start` and the Docker image to production,
# so leave this unset unless you need to override it.
# NODE_ENV=development
# API port. In development the Vite dev server (:3000) proxies /api here.
PORT=3001
# Listen address (default: all interfaces).
# HOST=127.0.0.1

# Signs session cookies: at least 32 random characters. This placeholder is
# rejected on purpose. Generate a value with:  openssl rand -base64 48
SESSION_SECRET="change-me-run-openssl-rand-base64-48"

# Browser origins allowed to call the API with credentials: comma-separated
# scheme://host[:port], https only in production. Localhost is allowed in
# development. docker-compose.prod.yml defaults this to https://$DOMAIN.
# ALLOWED_ORIGINS="https://app.your-domain.com"

# Number of reverse-proxy hops in front of the app (Express "trust proxy").
# Leave unset when clients connect directly; docker-compose.prod.yml sets 1
# for its Traefik proxy. A wrong value lets clients spoof their IP.
# TRUST_PROXY=1

# Secret required to create the first (owner) account in the setup flow
# (create-toto-app generates one). If unset, a one-time token is generated per
# boot and printed once to stderr while no user exists; set it when running several
# instances. Useless once the owner exists.
# SETUP_TOKEN=

# Encrypts TOTP secrets at rest (AES-256-GCM): 32 bytes as hex or base64,
# e.g.  openssl rand -hex 32  (create-toto-app generates one). Optional, but
# once set keep it stable: losing or changing it breaks MFA sign-in for every
# enrolled user (they must re-enroll). Back it up with your secrets.
# OTP_ENCRYPTION_KEY=

# Issuer label shown in authenticator apps. Default: host of the first
# allowed origin, else "toto-stack".
# TOTP_ISSUER="My App"

# Log level: debug | info | warn | error | silent (default: debug in dev, info otherwise).
# LOG_LEVEL=info

# --------------------------------------------------------------- database ---
# Used by the app (server/prisma.ts), Prisma CLI (prisma.config.ts) and
# docker-compose.yml. MYSQL_HOST is for local development; inside compose the
# app and migrations connect to the `db` service instead.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=app
MYSQL_USER=app
# Use long random values, e.g.  openssl rand -hex 24
MYSQL_PASSWORD="change-me-app-password"
# Only used to initialize the database container; never passed to the app.
MYSQL_ROOT_PASSWORD="change-me-root-password"

# `npm run db:migrate` (prisma migrate dev) needs a throwaway shadow database.
# The dev compose setup lets MYSQL_USER create one. Against any other server,
# point this at a database that a sufficiently privileged user can reset:
# SHADOW_DATABASE_URL="mysql://root:password@127.0.0.1:3306/app_shadow"

# ------------------------------------------- production (docker-compose.prod.yml) ---
# Public hostname served by Traefik, and the Let's Encrypt account email.
# Both are required by docker-compose.prod.yml.
DOMAIN=
ACME_EMAIL=
# Make a plain `docker compose up -d` use the production stack on the server:
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# ------------------------------------------------------- email (optional) ---
# Email is disabled until SMTP_HOST is set.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_SECURE=false
